# Runtime environment: local | railway
ENVIRONMENT=local

# Comma-separated list of origins allowed to call this API.
# In Railway, set this to your deployed frontend URL, e.g. https://fischer-chess.up.railway.app
CORS_ORIGINS=http://localhost:1010,http://127.0.0.1:1010

# Reserved for future phases (model checkpoint path, Stockfish binary path, etc.)
MODEL_CHECKPOINT_PATH=./checkpoints/action_plane/best_fischer_bc.pth
STOCKFISH_PATH="D:\TN\stockfish-windows-x86-64-avx2.exe"

TRAINING_STRICT_FEN_DISJOINT=true
TRAINING_METRICS_PATH=./logs/behavioral_cloning_metrics_strict_fen.csv
